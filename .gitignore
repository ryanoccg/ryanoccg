# Dependencies
node_modules/

# Cloudflare Worker (managed separately)
worker/

# Shared internal configs (not needed in repo)
.shared/
.github/prompts/

# Build output — upload dist/ to cPanel manually, don't commit
dist/

# Environment & secrets
.env
.env.local
.env.*.local

# Google API credentials & tokens (NEVER COMMIT!)
credentials.json
token.json
token.json.*
*.bak
*.tmp.*

# Local-only OAuth & data-fetch helpers (dev tools, never deploy)
reauth.py
fetch_seo_data.py

# Analytics & SEO data (all generated outputs)
temp-seo.json
website_analysis.json
previous_period.json
gsc_data.json
gsc_index_status.json
seo_report_data.json
ai-ready-content.html

# WordPress plugins (managed by WordPress, not version controlled)
blogs/wp-content/plugins/
blogs/wp-content/uploads/

# Python analytics scripts (project-specific, not for production)
ga_oauth_client.py
gsc_oauth_client.py
analyze_website.py
list_gsc_sites.py
seo_sitemap_submit.py

# Node helper scripts (local-only: blog publishing, thumbnail gen, Unsplash, WP-CLI sync)
# Production runs dist/ + WordPress — scripts/ are dev tools that don't deploy.
scripts/

# Local-first workflow helper (only used when publishing to DDEV instead of production)
convert-md-to-html.js

# Blog skill generated content (re-generate with scripts)
blog/
blogs/blog/

# Markdown docs — only README.md is kept
*.md
!README.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
*.log
npm-debug.log*

# Vite cache
.vite/

# ── Meal expense splitter app (split/) ──────────────────────────────
# Real secrets & local env — NEVER COMMIT. Templates (*.example.*) are kept.
split/api/secrets.php
split/frontend/.env
split/frontend/.env.local
split/frontend/.env.*.local
# Locally-stored receipt images. In production these live OUTSIDE the web root
# (cfg uploads_dir); the local-dev fallback writes here — never commit them.
split/private_uploads/
split/api/private_uploads/
split/**/uploads/
# TypeScript incremental build cache
split/frontend/*.tsbuildinfo
# Keep the app's own markdown docs (override the global *.md ignore above)
!split/**/*.md

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
	
    RewriteEngine On
	RewriteBase /

    # Redirect to HTTPS (applies to all domains)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect www to non-www (applies to all domains)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Main domain rewrite rules (only for ryanoccg.com)
    RewriteCond %{HTTP_HOST} ^ryanoccg\.com$ [NC]

    # 首頁導向 dist/index.html
    RewriteRule ^$ dist/index.html [L]

    # 如果請求的檔案或資料夾真實存在於根目錄,直接存取
    RewriteCond %{HTTP_HOST} ^ryanoccg\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI} -d
    RewriteRule ^ - [L]

    # blogs/ → WordPress installation (serve from root blogs/ directory)
    RewriteCond %{HTTP_HOST} ^ryanoccg\.com$ [NC]
    RewriteRule ^blogs(/.*)?$ blogs$1 [L]

    # Portfolio path → SPA fallback (dist/index.html)
    RewriteCond %{HTTP_HOST} ^ryanoccg\.com$ [NC]
    RewriteRule ^portfolio(/.*)?$ dist/index.html [L]

    # 其他路徑才重定向到 dist/
    RewriteCond %{HTTP_HOST} ^ryanoccg\.com$ [NC]
    RewriteRule ^((?!dist/).*)$ dist/$1 [L,NC]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

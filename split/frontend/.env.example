# Frontend build-time vars (Vite). Copy to .env (gitignored) for local dev.
# Only VITE_-prefixed vars are exposed to the browser — never put secrets here.

# Base URL for API calls. Same-origin in production; the Vite dev proxy maps
# /api to the local PHP server, so '/api' works in both.
VITE_API_BASE=/api

# Public Google AdSense client id (shown to Free-plan users only).
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
